    "https://superb-mousse-452212.netlify.app",
    "http://localhost:5173",
]
NETLIFY_REGEX = r"https://([a-z0-9-]+\.)?netlify\.app$"

app.add_middleware(
    CORSMiddleware,
    allow_origins=ALLOWED_ORIGINS,
